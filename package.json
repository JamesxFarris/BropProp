{
  "name": "bropprop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Esports prop line logger and edge finder (PrizePicks / Underdog)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/migrate.ts",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 6 && npm run db:migrate",
    "poll": "tsx src/poll.ts",
    "start": "tsx src/main.ts",
    "report": "tsx src/report.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "worker": "tsx src/cron.ts",
    "web": "tsx src/web/server.ts",
    "grade": "tsx src/results/run.ts",
    "backfill": "tsx src/results/backfill.ts",
    "oe": "tsx src/results/oracleselixir.ts",
    "backfill:cs2": "tsx src/results/hltv_backfill.ts",
    "bo3": "tsx src/results/bo3.ts",
    "bo3:rounds": "tsx src/results/bo3_rounds.ts",
    "validate:stale": "tsx src/results/validate_stale.ts",
    "validate:calls": "tsx src/results/validate_calls.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2"
  }
}
