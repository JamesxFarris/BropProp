# Postgres — matches docker-compose.yml defaults
DATABASE_URL=postgres://bropprop:bropprop@localhost:5433/bropprop

# Poll cadence (cron syntax). Default: every 15 minutes.
POLL_CRON=*/15 * * * *

# Leagues to log. Comma-separated canonical codes: CS2,LOL,APEX,VAL
LEAGUES=CS2,LOL

# Keep the raw JSON payload of each poll on disk (useful for backfills/replays).
# Leave FALSE in production: ~15MB per poll is ~1.4GB/day on an ephemeral disk.
ARCHIVE_RAW=false
RAW_DIR=./raw

# Set to "false" to force-disable TLS to Postgres. Otherwise it is inferred:
# off for localhost and Railway private networking, on for public managed hosts.
# DATABASE_SSL=false

# Dashboard auth. Leave unset locally; SET THIS IN PRODUCTION — the dashboard
# accepts writes (taking props) and Railway URLs are guessable.
# DASHBOARD_USER=brop
# DASHBOARD_PASSWORD=

# How often to fetch match results and grade picks. Much less frequent than
# polling: results arrive late and the stat sources rate-limit hard.
RESULTS_CRON=17,47 * * * *
